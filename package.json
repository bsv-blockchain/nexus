{
  "name": "nexus",
  "private": true,
  "version": "0.0.0",
  "description": "Nexus — BSV wallet + browser across mobile and desktop",
  "workspaces": [
    "apps/desktop",
    "apps/mobile",
    "packages/*"
  ],
  "scripts": {
    "serve": "node tools/serve.mjs",
    "desktop": "npm --workspace @nexus/desktop run dev",
    "mobile": "npm --workspace @nexus/mobile run start",
    "ios": "npm --workspace @nexus/mobile run ios",
    "android": "npm --workspace @nexus/mobile run android",
    "ui:build": "node tools/build-ui.mjs",
    "ui:dev": "npm run dev --prefix apps/ui",
    "typecheck": "tsc --noEmit -p apps/mobile",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test-timeout=60000 --test \"packages/*/test/**/*.test.mjs\"",
    "check": "node tools/check-injection-sources.mjs",
    "ui:bundle": "node tools/build-ui.mjs && node tools/bundle-ui.mjs",
    "postinstall": "patch-package"
  },
  "devDependencies": {
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@bsv/message-box-client": "2.2.1",
    "@bsv/sdk": "2.1.9",
    "@bsv/templates": "1.9.6",
    "@bsv/wallet-toolbox-mobile": "2.4.3",
    "i18next": "^25.2.1",
    "mobx": "^6.13.7"
  }
}
