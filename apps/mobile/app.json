{
  "expo": {
    "name": "Nexus",
    "slug": "nexus",
    "version": "0.2.1",
    "scheme": "nexus",
    "newArchEnabled": true,
    "owner": "bsvb",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "org.bsvassociation.nexus",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Nexus uses the camera to scan payment codes and addresses.",
        "NSFaceIDUsageDescription": "Nexus uses Face ID to protect your wallet's recovery phrase.",
        "NSBonjourServices": [
          "_bsvpay._tcp"
        ],
        "NSLocalNetworkUsageDescription": "Nexus uses the local network to send and receive payments directly between nearby devices."
      }
    },
    "android": {
      "package": "org.bsvassociation.nexus"
    },
    "extra": {
      "chromeUrl": "bundled",
      "eas": {
        "projectId": "59d9d49d-07e1-455c-8f93-1607a2f54341"
      }
    },
    "plugins": [
      "./plugins/withBundledUi"
    ]
  }
}