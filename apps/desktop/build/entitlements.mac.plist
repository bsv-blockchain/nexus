<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron's own renderer/JIT requirements under the hardened runtime. Without
       these three the app is signed but crashes on launch. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <!-- The renderer helper loads our own preload bundle and, with sandbox: false,
       Node's own dylibs. Without this the signed app started every process, began the
       navigation, and then the renderer went silent — no window, no did-fail-load, no
       preload-error, nothing. The unsigned build of the identical bits worked. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- A browser has to reach the network, and the wallet has to reach the chain. -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
