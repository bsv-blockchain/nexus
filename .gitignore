node_modules/
.expo/
dist/
build/
web-build/
/apps/mobile/ios/
/apps/mobile/android/
*.log
.DS_Store
.env.local
apps/desktop/out/
# Build output of build-main.mjs — regenerated by every `npm run build` in apps/desktop.
apps/desktop/dist-electron/
# Scratch probes used to validate the wallet stack in Electron main.
apps/desktop/.probe/
apps/mobile/.expo/

# Local build artifacts — never commit (tens of MB each)
*.ipa
*.aab
*.apk

# Generated: 28 MB static export, rebuilt by `npm run ui:bundle`. One copy per shell.
apps/mobile/assets/ui/
apps/desktop/ui/

# apps/ui IS our source and is tracked. Only its build products are not.
apps/ui/node_modules/
apps/ui/.next/
apps/ui/out/

# Rust/native build output — the tracked source builds these; they are 1.4 GB when present
packages/react-native-*/node_modules/
packages/react-native-*/ios/*.xcframework/
packages/react-native-*/android/build/
packages/react-native-*/android/.cxx/
native-*/target/

# Signing material must never enter git: the Android upload keystore and the
# credentials.json that eas credentials reads passwords from.
credentials.json
*.jks
*.keystore
